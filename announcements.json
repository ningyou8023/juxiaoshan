{
  "schemaVersion": 1,
  "announcements": [
    {
      "id": "welcome",
      "revision": "2",
      "enabled": true,
      "title": "欢迎来到剧小闪",
      "content": [
        {
          "align": "center",
          "spans": [
            { "text": "把碎片时光，交给好故事", "fontSize": 18, "bold": true, "color": "#199B8A" }
          ]
        },
        {
          "spans": [
            { "text": "欢迎来到剧小闪！在通勤路上、午休片刻，或忙完一天的闲暇里，挑一部感兴趣的短剧，让短暂的休息也有故事相伴。", "fontSize": 14 }
          ]
        },
        {
          "spans": [
            { "text": "找剧更有方向。", "bold": true, "fontSize": 14 },
            { "text": "从剧场推荐、分类筛选和热搜榜单中发现真人剧、漫剧与 AI 剧，也可以直接搜索剧名。想尝鲜时，看看新剧推荐与上新日历，把期待的作品加入本机预约。", "fontSize": 14 }
          ]
        },
        {
          "spans": [
            { "text": "观看跟着你的节奏。", "bold": true, "fontSize": 14 },
            { "text": "上下滑动切换前后集，分季浏览与百集分段让长篇故事也好找。按喜好选择倍速和可用画质，开启自动播放下一集；横向视频还可切换全屏，专心看眼前的剧情。", "fontSize": 14 }
          ]
        },
        {
          "spans": [
            { "text": "跟着弹幕一起入戏。", "bold": true, "fontSize": 14 },
            { "text": "让文字与表情为追剧添一点陪伴，字号、透明度、滚动速度和显示行数都能按习惯调整。想安静观看时，可以关闭弹幕或切到清屏，也能通过屏蔽词减少不想看到的内容。", "fontSize": 14 }
          ]
        },
        {
          "spans": [
            { "text": "喜欢的故事，留给下一次。", "bold": true, "fontSize": 14 },
            { "text": "点亮红心收藏作品，在追剧页查看收藏、观看历史与预约记录。观看进度保存在本机，下次回来从熟悉的地方继续，选好的倍速与画质偏好也会保留。", "fontSize": 14 }
          ]
        },
        {
          "spans": [
            { "text": "让每次打开更顺手。", "bold": true, "fontSize": 14 },
            { "text": "清透的液态玻璃搭配青蓝与薄荷绿，浅色清爽，深色沉静。外观可跟随系统，也能手动选择；标准与大号字体提供预览，让找剧、选集和阅读介绍都更合适。愿你每次打开，都能遇见想接着看的好故事。", "fontSize": 14 }
          ]
        },
        {
          "spans": [
            { "text": "查看应用介绍与版本发布", "url": "https://github.com/ningyou8023/juxiaoshan", "bold": true, "underline": true }
          ]
        },
        {
          "spans": [
            { "text": "加入官方群进行反馈", "url": "https://qm.qq.com/q/4nu4skoYEM", "bold": true, "underline": true }
          ]
        }
      ]
    },
    {
      "id": "usage-notice",
      "revision": "1",
      "enabled": false,
      "title": "使用提醒",
      "content": [
        {
          "spans": [
            { "text": "作品和素材归各自权利人所有。", "bold": true, "color": "#DB7556", "fontSize": 16 },
            { "text": "内容与播放可用性以第三方服务返回为准，请通过正规渠道支持创作者。" }
          ]
        },
        {
          "spans": [
            { "text": "更多说明可在“我的 → 免责声明”中查看。" }
          ]
        }
      ]
    }
  ]
}
